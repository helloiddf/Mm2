local CurrentWord = ""
local ToggleKey = Enum.KeyCode.RightShift
local isListeningForKey = false

-- 단어 검색 함수
SearchBtn.MouseButton1Click:Connect(function()
    local char = InputBox.Text
    if char == "" or string.len(char) < 1 then
        ResultLabel.Text = "❌ 글자를 입력하세요!"
        ResultLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        return
    end

    local searchChar = char
    if char == "녀" then searchChar = "여"
    elseif char == "뇨" then searchChar = "요"
    elseif char == "뉴" then searchChar = "유"
    elseif char == "니" then searchChar = "이"
    elseif char == "랴" then searchChar = "야"
    elseif char == "려" then searchChar = "여"
    elseif char == "료" then searchChar = "요"
    elseif char == "류" then searchChar = "유"
    elseif char == "리" then searchChar = "이"
    elseif char == "라" then searchChar = "나"
    elseif char == "로" then searchChar = "노"
    elseif char == "뮴" then searchChar = "늄" 
    end

    local wordList = OneShotDict[searchChar] or OneShotDict[char]
    
    if wordList then
        local availableWords = {}
        for _, word in ipairs(wordList) do
            if not UsedWords[word] then
                table.insert(availableWords, word)
            end
        end
        
        if #availableWords > 0 then
            CurrentWord = availableWords[math.random(1, #availableWords)]
            ResultLabel.Text = "🔥 발견: " .. CurrentWord
            ResultLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        else
            ResultLabel.Text = "⚠️ DB에 남은 단어가 없습니다!"
            ResultLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            CurrentWord = ""
        end
    else
        ResultLabel.Text = "⚠️ DB에 없음! (일반 단어 쓰세요)"
        ResultLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        CurrentWord = ""
    end
end)

-- 채팅 전송
local function SendChat(text)
    if text == "" then return end
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local channel = TextChatService.TextChannels.RBXGeneral
        if channel then channel:SendAsync(text) end
    else
        ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(text, "All")
    end
end

ChatBtn.MouseButton1Click:Connect(function()
    if CurrentWord ~= "" then
        SendChat(CurrentWord)
        UsedWords[CurrentWord] = true
        ResultLabel.Text = "✅ 전송 완료 (기록됨): " .. CurrentWord
        ResultLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
        CurrentWord = ""
    else
        ResultLabel.Text = "❌ 먼저 검색을 눌러주세요!"
        ResultLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

-- 기록 초기화 함수
ResetBtn.MouseButton1Click:Connect(function()
    UsedWords = {} 
    ResultLabel.Text = "🔄 사용 기록이 초기화되었습니다!"
    ResultLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
end)

-- ★ 키바인드 변경 모드 진입
KeybindBtn.MouseButton1Click:Connect(function()
    isListeningForKey = true
    KeybindBtn.Text = "⌨️ 변경할 키를 누르세요..."
    KeybindBtn.TextColor3 = Color3.fromRGB(255, 255, 0)
end)

-- ★ 키 입력 감지 (UI 토글 및 키바인드 변경 처리)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if isListeningForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            ToggleKey = input.KeyCode
            isListeningForKey = false
            KeybindBtn.Text = "⌨️ UI 토글 키 설정: [" .. tostring(ToggleKey.Name) .. "]"
            KeybindBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
    else
        if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == ToggleKey then
                MainFrame.Visible = not MainFrame.Visible -- UI 켜기 /끄기 전환
            end
        end
    end
end)
