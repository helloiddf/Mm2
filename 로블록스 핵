local ConfigName = "LO_FTAP_Config.json"
local Config = {
    ToggleKey = Enum.KeyCode.RightShift,
    FlySpeed = 50,
    FlingPower = 1,
    WalkSpeed = 16,
    JumpPower = 50,
    ESP = {
        Enabled = false,
        Boxes = false,
        Skeletons = false,
        Tracers = false,
        HealthBar = false,
        Names = false,
        Color = Color3.fromRGB(138, 43, 226)
    },
    Exploits = {
        AntiGrab = false,
        AntiFling = false,
        AntiVoid = false,
        GrabKill = false,
        Blackhole = false,
        AuraFling = false,
        GodMode = false
    }
